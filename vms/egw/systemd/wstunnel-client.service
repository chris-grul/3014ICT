[Unit]
Description=wstunnel client (WireGuard over TCP/443)
After=network-online.target
Wants=network-online.target
[Service]
ExecStart=/usr/local/bin/wstunnel client --connection-min-idle 5 -L 'udp://51820:localhost:51820?timeout_sec=0' wss://112.213.39.252:443
Restart=always
RestartSec=3
DynamicUser=yes
[Install]
WantedBy=multi-user.target
