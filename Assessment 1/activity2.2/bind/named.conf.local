// Replace YOURDOMAIN with your actual domain (e.g. rishon7015ict.com)

zone "chrisgrul-3014ict.com" {
    type master;
    file "/etc/bind/zones/db.chrisgrul-3014ict.com";
};

// split horizon DNS, internal is only authoritative
// for sub-domain internally
zone "3014ict.chris.grul.me" {
    type master;
    file "/etc/bind/zones/db.3014ict.chris.grul.me";
};

zone "1.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.192.168.1";
};

zone "0.1.f.d.1.c.9.2.0.0.4.9.4.0.4.2.ip6.arpa" {
    type master;
    file "/etc/bind/zones/db.2404.9400.29c1.df10";
};
